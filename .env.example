# Copy this file to .env. Keep API keys and access tokens out of source control.
# Prefer adding vision models in the client (视觉模型 button): keys, endpoints and
# model names are encrypted with your passphrase and only unlocked in the client.
# Anything written here is plain text that any program on this computer can read.
# auto: Ollama -> OpenAI-compatible -> xAI (temporary stand-in) -> local technical fallback.
# Explicit openai/xai never probes Ollama. local disables all visual API calls.
SUPERPHOTO_VISION_PROVIDER=auto

# Generic OpenAI-compatible vision provider; set the model supported by your API.
# SUPERPHOTO_OPENAI_API_KEY=
# SUPERPHOTO_OPENAI_BASE_URL=https://api.openai.com/v1
# SUPERPHOTO_OPENAI_MODEL=your-vision-model
# Choose the protocol implemented by the provider; these are different APIs.
# SUPERPHOTO_OPENAI_PROTOCOL=chat/completions
# Or: responses
# SUPERPHOTO_VISION_TIMEOUT=90
# SUPERPHOTO_VISION_MAX_RETRIES=1
# auto negotiates schema -> JSON object -> prompt only on format rejection.
# SUPERPHOTO_VISION_SCHEMA_MODE=auto

# xAI (Grok) is a TEMPORARY stand-in for when no other vision model is available.
# In auto it is tried last, so a running Ollama or a configured OpenAI-compatible
# vision model replaces it without further changes; audits mark it temporary_provider.
# It works through every visual stage. Photos are sent to xAI when it is used.
XAI_API_KEY=
XAI_MODEL=grok-4.6
# SUPERPHOTO_XAI_BASE_URL=https://api.x.ai/v1
# SUPERPHOTO_XAI_PROTOCOL=responses

# Optional local visual model. Not started/downloaded for explicit cloud/local.
# SUPERPHOTO_OLLAMA_ENABLED=1
# SUPERPHOTO_OLLAMA_URL=http://127.0.0.1:11434
# SUPERPHOTO_OLLAMA_MODEL=qwen3-vl:32b

# Native LightCraft: install-lightcraft selects Windows/macOS/Linux + CPU arch.
# SUPERPHOTO_LIGHTROOM_ENABLED=1
# SUPERPHOTO_LIGHTCRAFT_BIN=D:/path/to/lightcraft-cli.exe
# Linux/macOS: /path/to/lightcraft-cli
# SUPERPHOTO_LIGHTROOM_EXPORT_EDGE=2400
# One LightCraft process per plan renders its probes without decoding the photo again (about 5x faster).
# Set to 0 to render every file with its own process, as before.
# SUPERPHOTO_LIGHTCRAFT_SESSIONS=1
# LightCraft AI Denoise on the final render of a Bayer RAW shot at high ISO or brightened a lot (JPEGs are left alone).
# The denoised data (about 150 MB per 45 MP photo) is kept under data/denoise, up to this many GB.
# SUPERPHOTO_AI_DENOISE=1
# SUPERPHOTO_AI_DENOISE_CACHE_GB=4
# SUPERPHOTO_VISUAL_REVIEW_ENABLED=1
# Experimental aesthetic refinement remains off by default.
# SUPERPHOTO_FINISHING_REVIEW_ENABLED=0
# SUPERPHOTO_FINISHING_MAX_ROUNDS=2
# SUPERPHOTO_LIGHTROOM_REQUIRE_DISTINCT_CANDIDATES=1

# Vision-directed finishing (needs LightCraft plus a vision model).
# auto: the vision model reads what is in the picture, chooses a direction for
#   each version (A stays the natural finish) using your earlier pass / keep /
#   favourite picks on similar photos, writes LightCraft settings with masks,
#   and one batched request checks all renders for damage; falls back to the
#   legacy slider pipeline when no vision model is ready or nothing passes.
# directed: fail the job instead of falling back. legacy: never use it.
# Check the model first with: uv run superphoto vision-check --list-models
# SUPERPHOTO_PIPELINE_MODE=auto
# Versions per photo (3-9); 3 = the fixed natural / dramatic / palette trio.
# SUPERPHOTO_DIRECTED_VERSIONS=6
# Per-version review-and-revise rounds; 0 = one batched damage check instead.
# SUPERPHOTO_DIRECTED_MAX_REVISIONS=0
# SUPERPHOTO_DIRECTED_VISION_TIMEOUT=240

# Optional semantic segmentation. Low-memory NAS can leave it disabled.
# Install: uv sync --extra semantic; pre-download the model before use.
# HF_HOME / HF_HUB_CACHE and complete sharded model caches are supported.
# SUPERPHOTO_SEMANTIC_ENABLED=0
# SUPERPHOTO_SEMANTIC_MODEL=nvidia/segformer-b0-finetuned-ade-512-512
# SUPERPHOTO_SEMANTIC_MIN_CONFIDENCE=0.48

# Keep the DB, worker lock and job workspace on a LOCAL filesystem.
# One server process per data directory. Source photos may live on a NAS share.
# SUPERPHOTO_DATA_DIR=./data
# SUPERPHOTO_HOST=127.0.0.1
# SUPERPHOTO_PORT=8765
# For LAN access use 0.0.0.0 plus a long random access token.
# Browser: login form + HttpOnly cookie. Clients: Authorization: Bearer <token>.
# SUPERPHOTO_ACCESS_TOKEN=
