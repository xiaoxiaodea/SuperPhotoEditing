# Local vision critic (Ollama). Default: qwen3-vl:32b
# SUPERPHOTO_OLLAMA_ENABLED=1
# SUPERPHOTO_OLLAMA_URL=http://127.0.0.1:11434
# SUPERPHOTO_OLLAMA_MODEL=qwen3-vl:32b

# SpaceXAI fallback if Ollama is down.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Optional semantic segmentation for subject/sky/water/foliage protection.
# Install with: uv sync --extra semantic
# SUPERPHOTO_SEMANTIC_ENABLED=1
# SUPERPHOTO_SEMANTIC_MODEL=nvidia/segformer-b0-finetuned-ade-512-512
# SUPERPHOTO_SEMANTIC_MIN_CONFIDENCE=0.48

# LightCraft CLI finishing. install-lightcraft downloads the pinned binary.
# SUPERPHOTO_LIGHTROOM_ENABLED=1
# SUPERPHOTO_LIGHTCRAFT_BIN=./vendor/lightcraft/lightcraft-cli
# SUPERPHOTO_LIGHTROOM_EXPORT_EDGE=2400
# SUPERPHOTO_VISUAL_REVIEW_ENABLED=1
# Experimental actual-export finishing. Off until visual selection is reliable.
# SUPERPHOTO_FINISHING_REVIEW_ENABLED=0
# SUPERPHOTO_FINISHING_MAX_ROUNDS=2
# Enables bounded retries for similar candidates; similarity never aborts a job.
# SUPERPHOTO_LIGHTROOM_REQUIRE_DISTINCT_CANDIDATES=1

# SUPERPHOTO_DATA_DIR=./data
# SUPERPHOTO_HOST=127.0.0.1
# SUPERPHOTO_PORT=8765
